  <diagram id="5u4F6WGALMLnmkVKkYhx" name="软件优化">
    <mxGraphModel dx="1548" dy="902" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="H-vryxR3vom-TAB3DF1y-2" value="&lt;font color=&quot;#00cc00&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;长连接接入网关&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1、提升单机设备接入数量，较少的服务器承载公司千万级设备的接入，&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;减少&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;云服务器基础开支&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2、稳定、高性能，协议交换低延时&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="180" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="H-vryxR3vom-TAB3DF1y-3" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;高性能团队，部门技术牛人，专注于核心模块的性能提升，如接入网关、解码、流媒体、进程间通信&lt;br&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="60" width="590" height="90" as="geometry" />
        </mxCell>
        <mxCell id="H-vryxR3vom-TAB3DF1y-4" value="&lt;font color=&quot;#00cc00&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;流媒体&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1、提升弱网对抗能力，高效+可靠传输，70%的丢包情况，视频流畅&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2、提升P2P穿透成功率80%；穿透稳定、连接低延时&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="330" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="H-vryxR3vom-TAB3DF1y-5" value="&lt;font color=&quot;#00cc00&quot; style=&quot;font-size: 16px;&quot;&gt;解码&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1、无控件解码&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2、解码库性能优化，支持手机端gpu解码&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3、优异的音质体验，支持智能降噪&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;4、增强视觉体验：低码高清、超分、美颜、急速出图&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;5、跨平台，支持小程序、app、pc&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="475" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="H-vryxR3vom-TAB3DF1y-6" value="&lt;font color=&quot;#00cc00&quot; style=&quot;font-size: 16px;&quot;&gt;进程间通信（RPC)&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1、协议短小&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;2、性能优异&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3、跨语言&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;（http + protobuf）&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="641" width="400" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
